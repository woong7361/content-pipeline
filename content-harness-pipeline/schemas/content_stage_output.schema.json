{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Content Production Stage Output",
  "type": "object",
  "required": ["stage", "status", "files_written", "summary", "open_questions", "token_time_estimate"],
  "properties": {
    "stage": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": ["PASS", "NEEDS_INTERVIEW", "REJECT"]
    },
    "files_written": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "token_time_estimate": {
      "type": "object",
      "required": ["input_tokens", "output_tokens", "minutes"],
      "properties": {
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "minutes": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
