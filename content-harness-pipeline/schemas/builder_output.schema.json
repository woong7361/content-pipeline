{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Builder Direct Output",
  "type": "object",
  "required": ["html_path", "asset_paths", "implemented_sections", "implemented_interactions"],
  "properties": {
    "html_path": {
      "type": "string",
      "const": "output/index.html",
      "description": "run 디렉토리 기준 단일 HTML 저장 경로"
    },
    "asset_paths": {
      "type": "array",
      "description": "index.html에서 참조한 asset 경로 목록. asset을 쓰지 않으면 빈 배열을 사용한다",
      "items": {
        "type": "string",
        "pattern": "^output/assets/[^/\\\\]+\\.(png|jpg|jpeg|webp)$"
      }
    },
    "implemented_sections": {
      "type": "array",
      "minItems": 1,
      "description": "index.html에 구현한 planner section id 목록",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]*$"
      }
    },
    "implemented_interactions": {
      "type": "array",
      "description": "index.html에 구현한 planner interaction id 목록. 없으면 빈 배열을 사용한다",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]*$"
      }
    }
  },
  "additionalProperties": false
}
