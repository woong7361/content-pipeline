{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Content Harness Input",
  "type": "object",
  "required": ["brief_hash", "created_at", "brief"],
  "properties": {
    "brief_hash": {
      "type": "string",
      "pattern": "^[a-z0-9]{8,}$",
      "description": "입력 식별자"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "입력 JSON 생성 시각"
    },
    "brief": {
      "type": "object",
      "description": "콘텐츠 생성을 위한 사용자 입력",
      "required": ["md_path"],
      "properties": {
        "md_path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^.*\\.md$",
          "description": "story board Markdown 파일 경로"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "description": "콘텐츠 제목"
        },
        "user_request": {
          "type": "string",
          "minLength": 1,
          "description": "story board 외에 사용자가 추가로 전달하는 선택 요청"
        }
      },
      "additionalProperties": false
    },
    "metadata": {
      "type": "object",
      "description": "선택 부가 정보",
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
