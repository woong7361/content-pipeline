{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Senior Designer Review Model Output",
  "type": "object",
  "required": [
    "status",
    "overall_assessment",
    "scene_reviews",
    "motion_review",
    "asset_review",
    "priority_findings",
    "refine_suggestions"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["PASS", "REJECT"]
    },
    "overall_assessment": {
      "type": "string",
      "minLength": 1
    },
    "scene_reviews": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/sceneReview" }
    },
    "motion_review": { "$ref": "#/$defs/motionReview" },
    "priority_findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/priorityFinding" }
    },
    "asset_review": {
      "type": "object",
      "required": [
        "overall_asset_fit",
        "keep_assets",
        "reposition_assets",
        "remove_assets",
        "regenerate_assets",
        "new_asset_requests",
        "deferred_asset_candidates"
      ],
      "properties": {
        "overall_asset_fit": {
          "type": "string",
          "minLength": 1
        },
        "keep_assets": {
          "type": "array",
          "items": { "$ref": "#/$defs/assetDecision" }
        },
        "reposition_assets": {
          "type": "array",
          "items": { "$ref": "#/$defs/assetDecision" }
        },
        "remove_assets": {
          "type": "array",
          "items": { "$ref": "#/$defs/assetDecision" }
        },
        "regenerate_assets": {
          "type": "array",
          "items": { "$ref": "#/$defs/assetRegenerationRequest" }
        },
        "new_asset_requests": {
          "type": "array",
          "items": { "$ref": "#/$defs/newAssetRequest" }
        },
        "deferred_asset_candidates": {
          "type": "array",
          "description": "예산 밖으로 밀린 asset 후보. 다음 라운드로 이어가기 위한 기록",
          "items": { "$ref": "#/$defs/deferredAssetCandidate" }
        }
      },
      "additionalProperties": false
    },
    "refine_suggestions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "severity": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    },
    "axis": {
      "type": "string",
      "enum": [
        "asset_quality",
        "background_stage",
        "asset_component_fit",
        "card_button_panel_style",
        "creative_direction",
        "text_surface_fit",
        "motion"
      ]
    },
    "motionFinding": {
      "type": "object",
      "required": ["aspect", "scene_id", "severity", "target", "issue", "evidence", "suggested_fix"],
      "properties": {
        "aspect": {
          "type": "string",
          "enum": [
            "scene_transition",
            "entrance_choreography",
            "feedback_reaction",
            "answer_reveal",
            "micro_interaction"
          ],
          "description": "연출/모션 유형. scene_transition=화면 전환, entrance_choreography=요소·캐릭터 순차 등장, feedback_reaction=정답/오답 반응 연출, answer_reveal=정답 표시 연출, micro_interaction=버튼/CTA hover·press·pulse"
        },
        "scene_id": {
          "type": "string",
          "minLength": 1,
          "description": "해당 scene_id. 전환 시스템처럼 전역 문제면 \"global\""
        },
        "severity": { "$ref": "#/$defs/severity" },
        "target": {
          "type": "string",
          "minLength": 1,
          "description": "수정 대상. CSS selector, @keyframes 이름, JS 함수/이벤트 핸들러, DOM id/class 등 design_refine이 코드에서 바로 찾을 수 있는 위치"
        },
        "issue": { "type": "string", "minLength": 1 },
        "evidence": {
          "type": "string",
          "minLength": 1,
          "description": "코드 근거. 관련 CSS 셀렉터/@keyframes/JS 핸들러를 인용한다. 예: showScene()는 hidden 클래스 토글만 하고 전환 애니메이션이 없음"
        },
        "suggested_fix": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "motionReview": {
      "type": "object",
      "required": ["summary", "findings"],
      "description": "코드(HTML/CSS/JS)를 읽고 판단하는 연출/모션 리뷰. 정적 스크린샷으로는 판단할 수 없는 시간 축 완성도를 다룬다",
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1,
          "description": "전환·등장 연출·피드백 반응 전반에 대한 코드 기반 판단"
        },
        "findings": {
          "type": "array",
          "items": { "$ref": "#/$defs/motionFinding" }
        }
      },
      "additionalProperties": false
    },
    "deferredAssetCandidate": {
      "type": "object",
      "required": ["target", "why_beneficial", "why_deferred"],
      "properties": {
        "target": {
          "type": "string",
          "minLength": 1,
          "description": "asset으로 만들면 좋은 표면/요소. selector, asset_id, 화면 영역 등"
        },
        "why_beneficial": { "type": "string", "minLength": 1, "description": "이미지로 만들면 무엇이 좋아지는지" },
        "why_deferred": { "type": "string", "minLength": 1, "description": "이번 예산에서 밀린 이유. 우선순위가 낮음 등" }
      },
      "additionalProperties": false
    },
    "creativeDirection": {
      "type": "object",
      "required": [
        "recommendation_level",
        "concept_name",
        "rationale",
        "core_metaphor",
        "visual_language",
        "layout_strategy",
        "interaction_surfaces",
        "implementation_notes"
      ],
      "properties": {
        "recommendation_level": {
          "type": "string",
          "enum": ["none", "light", "strong"]
        },
        "concept_name": { "type": "string", "minLength": 1 },
        "rationale": { "type": "string", "minLength": 1 },
        "core_metaphor": { "type": "string", "minLength": 1 },
        "visual_language": { "type": "string", "minLength": 1 },
        "layout_strategy": { "type": "string", "minLength": 1 },
        "interaction_surfaces": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "implementation_notes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "sceneReview": {
      "type": "object",
      "required": [
        "scene_id",
        "capture_label",
        "screenshot_path",
        "scene_purpose",
        "overall_assessment",
        "creative_direction",
        "text_review",
        "checks",
        "priority_findings",
        "refine_suggestions"
      ],
      "properties": {
        "scene_id": { "type": "string", "minLength": 1 },
        "capture_label": { "type": "string" },
        "screenshot_path": { "type": "string", "minLength": 1 },
        "scene_purpose": { "type": "string", "minLength": 1 },
        "overall_assessment": { "type": "string", "minLength": 1 },
        "creative_direction": { "$ref": "#/$defs/creativeDirection" },
        "text_review": { "$ref": "#/$defs/textReview" },
        "checks": {
          "type": "object",
          "required": [
            "asset_quality",
            "background_stage",
            "asset_component_fit",
            "card_button_panel_style"
          ],
          "properties": {
            "asset_quality": {
              "type": "array",
              "items": { "$ref": "#/$defs/designFinding" }
            },
            "background_stage": {
              "type": "array",
              "items": { "$ref": "#/$defs/designFinding" }
            },
            "asset_component_fit": {
              "type": "array",
              "items": { "$ref": "#/$defs/designFinding" }
            },
            "card_button_panel_style": {
              "type": "array",
              "items": { "$ref": "#/$defs/designFinding" }
            }
          },
          "additionalProperties": false
        },
        "priority_findings": {
          "type": "array",
          "items": { "$ref": "#/$defs/priorityFinding" }
        },
        "refine_suggestions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "textReview": {
      "type": "object",
      "required": [
        "hero_mission_text",
        "asset_internal_text",
        "action_feedback_text"
      ],
      "properties": {
        "hero_mission_text": {
          "type": "array",
          "items": { "$ref": "#/$defs/designFinding" }
        },
        "asset_internal_text": {
          "type": "array",
          "items": { "$ref": "#/$defs/designFinding" }
        },
        "action_feedback_text": {
          "type": "array",
          "items": { "$ref": "#/$defs/designFinding" }
        }
      },
      "additionalProperties": false
    },
    "designFinding": {
      "type": "object",
      "required": ["severity", "target", "issue", "evidence", "suggested_fix"],
      "properties": {
        "severity": {
          "$ref": "#/$defs/severity"
        },
        "target": {
          "type": "string",
          "minLength": 1,
          "description": "수정 대상. CSS selector, HTML id/class/tag, asset_id, screenshot 좌표/영역, crop/object-position 지시, 또는 이들을 조합한 문자열"
        },
        "issue": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        },
        "suggested_fix": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "priorityFinding": {
      "type": "object",
      "required": ["scene_id", "severity", "axis", "target", "issue", "evidence", "suggested_fix"],
      "properties": {
        "scene_id": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "$ref": "#/$defs/severity"
        },
        "axis": {
          "$ref": "#/$defs/axis"
        },
        "target": {
          "type": "string",
          "minLength": 1,
          "description": "수정 대상. CSS selector, HTML id/class/tag, asset_id, screenshot 좌표/영역, crop/object-position 지시, 또는 이들을 조합한 문자열"
        },
        "issue": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        },
        "suggested_fix": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "assetDecision": {
      "type": "object",
      "required": ["asset_id", "reason", "suggested_action"],
      "properties": {
        "asset_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "reason": { "type": "string", "minLength": 1 },
        "suggested_action": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "assetRegenerationRequest": {
      "type": "object",
      "required": [
        "asset_id",
        "priority",
        "impact",
        "reason",
        "suggested_action",
        "revised_prompt_brief",
        "visual_role",
        "style_constraints",
        "composition_notes",
        "negative_prompt",
        "usage_section_ids"
      ],
      "properties": {
        "asset_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "priority": { "type": "integer", "minimum": 1, "description": "요청 우선순위. 1=최우선. 예산 안에서 무엇부터 만들지 정렬용" },
        "impact": { "type": "string", "minLength": 1, "description": "이 재생성이 해결하는 디자인 임팩트와 시급성" },
        "reason": { "type": "string", "minLength": 1 },
        "suggested_action": { "type": "string", "minLength": 1 },
        "revised_prompt_brief": { "type": "string", "description": "바꿔야 할 때만 새 값을 쓴다. 유지하려면 빈 문자열. 빈 문자열이면 runner가 planner의 원래 값을 보존한다" },
        "visual_role": { "type": "string", "description": "바꿔야 할 때만 새 값을 쓴다. 유지하려면 빈 문자열" },
        "style_constraints": { "type": "string", "description": "바꿔야 할 때만 새 값을 쓴다. 유지하려면 빈 문자열. 캐릭터의 얼굴·헤어·의상·팔레트는 planner의 characters가 소유하므로 여기 쓰지 않고, 이 컷의 포즈·표정·소품·시선만 쓴다" },
        "composition_notes": { "type": "string", "description": "바꿔야 할 때만 새 값을 쓴다. 유지하려면 빈 문자열" },
        "negative_prompt": { "type": "string", "description": "바꿔야 할 때만 새 값을 쓴다. 유지하려면 빈 문자열" },
        "usage_section_ids": {
          "type": "array",
          "description": "바꿔야 할 때만 새 목록을 쓴다. 유지하려면 빈 배열",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          }
        }
      },
      "additionalProperties": false
    },
    "newAssetRequest": {
      "type": "object",
      "required": [
        "suggested_id",
        "priority",
        "impact",
        "kind",
        "character_id",
        "intended_path",
        "usage_section_ids",
        "purpose",
        "prompt_brief",
        "visual_role",
        "style_constraints",
        "composition_notes",
        "negative_prompt",
        "why_needed"
      ],
      "properties": {
        "suggested_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "character_id": {
          "type": "string",
          "pattern": "^$|^[a-z][a-z0-9_-]*$",
          "description": "이 asset이 그리는 캐릭터의 PLANNER_DESIGN_CONTEXT_JSON.characters[].id. 기존 캐릭터의 새 포즈를 요청하는 것이면 반드시 그 캐릭터 id를 넣어 정체성이 이어지게 한다. 캐릭터가 없는 asset(배경·소품·표면)이면 빈 문자열. 새 캐릭터를 여기서 만들지 않는다"
        },
        "priority": { "type": "integer", "minimum": 1, "description": "요청 우선순위. 1=최우선. 예산 안에서 무엇부터 만들지 정렬용" },
        "impact": { "type": "string", "minLength": 1, "description": "이 신규 asset이 해결하는 디자인 임팩트와 시급성" },
        "kind": {
          "type": "string",
          "enum": ["image"]
        },
        "intended_path": {
          "type": "string",
          "pattern": "^output/assets/[^/\\\\]+\\.(png|jpg|jpeg|webp)$"
        },
        "usage_section_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          }
        },
        "purpose": { "type": "string", "minLength": 1 },
        "prompt_brief": { "type": "string", "minLength": 1 },
        "visual_role": { "type": "string", "minLength": 1 },
        "style_constraints": { "type": "string", "minLength": 1 },
        "composition_notes": { "type": "string", "minLength": 1 },
        "negative_prompt": { "type": "string", "minLength": 1 },
        "why_needed": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
