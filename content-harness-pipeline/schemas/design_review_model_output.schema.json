{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Senior Designer Review Model Output",
  "type": "object",
  "required": [
    "status",
    "overall_assessment",
    "scene_reviews",
    "asset_review",
    "priority_findings",
    "refine_suggestions"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["PASS", "REJECT"]
    },
    "overall_assessment": {
      "type": "string",
      "minLength": 1
    },
    "scene_reviews": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/sceneReview" }
    },
    "priority_findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/priorityFinding" }
    },
    "asset_review": {
      "type": "object",
      "required": [
        "overall_asset_fit",
        "keep_assets",
        "reposition_assets",
        "remove_assets",
        "regenerate_assets",
        "new_asset_requests"
      ],
      "properties": {
        "overall_asset_fit": {
          "type": "string",
          "minLength": 1
        },
        "keep_assets": {
          "type": "array",
          "items": { "$ref": "#/$defs/assetDecision" }
        },
        "reposition_assets": {
          "type": "array",
          "items": { "$ref": "#/$defs/assetDecision" }
        },
        "remove_assets": {
          "type": "array",
          "items": { "$ref": "#/$defs/assetDecision" }
        },
        "regenerate_assets": {
          "type": "array",
          "maxItems": 3,
          "items": { "$ref": "#/$defs/assetRegenerationRequest" }
        },
        "new_asset_requests": {
          "type": "array",
          "maxItems": 3,
          "items": { "$ref": "#/$defs/newAssetRequest" }
        }
      },
      "additionalProperties": false
    },
    "refine_suggestions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "severity": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    },
    "axis": {
      "type": "string",
      "enum": [
        "asset_quality",
        "background_stage",
        "asset_component_fit",
        "card_button_panel_style",
        "creative_direction",
        "text_surface_fit"
      ]
    },
    "creativeDirection": {
      "type": "object",
      "required": [
        "recommendation_level",
        "concept_name",
        "rationale",
        "core_metaphor",
        "visual_language",
        "layout_strategy",
        "interaction_surfaces",
        "implementation_notes"
      ],
      "properties": {
        "recommendation_level": {
          "type": "string",
          "enum": ["none", "light", "strong"]
        },
        "concept_name": { "type": "string", "minLength": 1 },
        "rationale": { "type": "string", "minLength": 1 },
        "core_metaphor": { "type": "string", "minLength": 1 },
        "visual_language": { "type": "string", "minLength": 1 },
        "layout_strategy": { "type": "string", "minLength": 1 },
        "interaction_surfaces": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "implementation_notes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "sceneReview": {
      "type": "object",
      "required": [
        "scene_id",
        "capture_label",
        "screenshot_path",
        "scene_purpose",
        "overall_assessment",
        "creative_direction",
        "text_review",
        "checks",
        "priority_findings",
        "refine_suggestions"
      ],
      "properties": {
        "scene_id": { "type": "string", "minLength": 1 },
        "capture_label": { "type": "string" },
        "screenshot_path": { "type": "string", "minLength": 1 },
        "scene_purpose": { "type": "string", "minLength": 1 },
        "overall_assessment": { "type": "string", "minLength": 1 },
        "creative_direction": { "$ref": "#/$defs/creativeDirection" },
        "text_review": { "$ref": "#/$defs/textReview" },
        "checks": {
          "type": "object",
          "required": [
            "asset_quality",
            "background_stage",
            "asset_component_fit",
            "card_button_panel_style"
          ],
          "properties": {
            "asset_quality": {
              "type": "array",
              "items": { "$ref": "#/$defs/designFinding" }
            },
            "background_stage": {
              "type": "array",
              "items": { "$ref": "#/$defs/designFinding" }
            },
            "asset_component_fit": {
              "type": "array",
              "items": { "$ref": "#/$defs/designFinding" }
            },
            "card_button_panel_style": {
              "type": "array",
              "items": { "$ref": "#/$defs/designFinding" }
            }
          },
          "additionalProperties": false
        },
        "priority_findings": {
          "type": "array",
          "items": { "$ref": "#/$defs/priorityFinding" }
        },
        "refine_suggestions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "textReview": {
      "type": "object",
      "required": [
        "hero_mission_text",
        "asset_internal_text",
        "action_feedback_text"
      ],
      "properties": {
        "hero_mission_text": {
          "type": "array",
          "items": { "$ref": "#/$defs/designFinding" }
        },
        "asset_internal_text": {
          "type": "array",
          "items": { "$ref": "#/$defs/designFinding" }
        },
        "action_feedback_text": {
          "type": "array",
          "items": { "$ref": "#/$defs/designFinding" }
        }
      },
      "additionalProperties": false
    },
    "designFinding": {
      "type": "object",
      "required": ["severity", "target", "issue", "evidence", "suggested_fix"],
      "properties": {
        "severity": {
          "$ref": "#/$defs/severity"
        },
        "target": {
          "type": "string",
          "minLength": 1,
          "description": "수정 대상. CSS selector, HTML id/class/tag, asset_id, screenshot 좌표/영역, crop/object-position 지시, 또는 이들을 조합한 문자열"
        },
        "issue": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        },
        "suggested_fix": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "priorityFinding": {
      "type": "object",
      "required": ["scene_id", "severity", "axis", "target", "issue", "evidence", "suggested_fix"],
      "properties": {
        "scene_id": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "$ref": "#/$defs/severity"
        },
        "axis": {
          "$ref": "#/$defs/axis"
        },
        "target": {
          "type": "string",
          "minLength": 1,
          "description": "수정 대상. CSS selector, HTML id/class/tag, asset_id, screenshot 좌표/영역, crop/object-position 지시, 또는 이들을 조합한 문자열"
        },
        "issue": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        },
        "suggested_fix": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "assetDecision": {
      "type": "object",
      "required": ["asset_id", "reason", "suggested_action"],
      "properties": {
        "asset_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "reason": { "type": "string", "minLength": 1 },
        "suggested_action": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "assetRegenerationRequest": {
      "type": "object",
      "required": [
        "asset_id",
        "reason",
        "suggested_action",
        "revised_prompt_brief",
        "visual_role",
        "style_constraints",
        "composition_notes",
        "negative_prompt",
        "usage_section_ids"
      ],
      "properties": {
        "asset_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "reason": { "type": "string", "minLength": 1 },
        "suggested_action": { "type": "string", "minLength": 1 },
        "revised_prompt_brief": { "type": "string", "minLength": 1 },
        "visual_role": { "type": "string", "minLength": 1 },
        "style_constraints": { "type": "string", "minLength": 1 },
        "composition_notes": { "type": "string", "minLength": 1 },
        "negative_prompt": { "type": "string", "minLength": 1 },
        "usage_section_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          }
        }
      },
      "additionalProperties": false
    },
    "newAssetRequest": {
      "type": "object",
      "required": [
        "suggested_id",
        "kind",
        "intended_path",
        "usage_section_ids",
        "purpose",
        "prompt_brief",
        "visual_role",
        "style_constraints",
        "composition_notes",
        "negative_prompt",
        "why_needed"
      ],
      "properties": {
        "suggested_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "kind": {
          "type": "string",
          "enum": ["image"]
        },
        "intended_path": {
          "type": "string",
          "pattern": "^output/assets/[^/\\\\]+\\.(png|jpg|jpeg|webp)$"
        },
        "usage_section_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          }
        },
        "purpose": { "type": "string", "minLength": 1 },
        "prompt_brief": { "type": "string", "minLength": 1 },
        "visual_role": { "type": "string", "minLength": 1 },
        "style_constraints": { "type": "string", "minLength": 1 },
        "composition_notes": { "type": "string", "minLength": 1 },
        "negative_prompt": { "type": "string", "minLength": 1 },
        "why_needed": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
