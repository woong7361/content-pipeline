{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Scenario Author Output",
  "type": "object",
  "required": [
    "scenarios",
    "missing"
  ],
  "properties": {
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "intent",
          "start_section_id",
          "steps",
          "expect",
          "why_it_can_fail"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "intent": {
            "type": "string",
            "minLength": 1
          },
          "start_section_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "action",
                "values",
                "question_id"
              ],
              "properties": {
                "action": {
                  "type": "string",
                  "minLength": 1
                },
                "values": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "question_id": {
                  "type": "string",
                  "pattern": "^$|^[a-z][a-z0-9_-]*$"
                }
              },
              "additionalProperties": false
            }
          },
          "expect": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "kind",
                "value"
              ],
              "properties": {
                "kind": {
                  "type": "string",
                  "minLength": 1
                },
                "value": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "why_it_can_fail": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "missing": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "need",
          "reason"
        ],
        "properties": {
          "need": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
